# Used by `npm run deploy:beta` (vite build --mode beta), deployed to
# Cloudflare Pages (billsplitter-beta.pages.dev) via wrangler.
#
# Vite modes don't chain — `--mode beta` does NOT load .env.production, so
# this file needs its own complete values. Override either in
# .env.beta.local (gitignored) if beta should point at a different backend.

# Cloudflare Pages serves this project from the domain root, not a
# /BillSplitter/ subpath like GitHub Pages — see .env.production.
VITE_BASE_PATH=/

VITE_LIVE_SERVER_URL=https://your-billsplitter-server.example.com
