# Receipt scanning (formerly the external bill-processor Cloudflare Worker)
# now lives on the Go live-collaboration server — see server/DEPLOYMENT.md.
# Set the real value in .env.production.local (gitignored, not committed) —
# Vite merges .env.production.local over this file automatically.
VITE_LIVE_SERVER_URL=https://your-billsplitter-server.example.com

# Path the app is served from — GitHub Pages serves this repo under
# /BillSplitter/, so the PWA manifest/icon URLs and manifest start_url/scope
# need that prefix. Cloudflare Pages (beta) serves from the domain root
# instead — see .env.beta.
VITE_BASE_PATH=/BillSplitter/
