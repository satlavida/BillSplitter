# Copy this file to server/.env and fill in real values for local dev.
# server/.env is gitignored — never commit real secrets.
# Loaded automatically by internal/config.Load() when present; a real
# environment variable / EnvironmentFile always takes precedence over this
# file (see DEPLOYMENT.md for production).

# Required for "Scan Receipt" (POST /api/scan) to work locally. Get a key at
# https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional — defaults to google/gemini-3.1-flash-lite if unset.
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite
